{
    "name": "rebanho-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev:react": "vite",
        "build:react": "tsc -b && vite build",
        "dev:electron": "tsc --project src/electron/tsconfig.json && tsc -b && vite build && electron .",
        "transpile:electron": "tsc --project src/electron/tsconfig.json",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.4",
        "react": "^19.1.0",
        "react-dom": "^19.0.0",
        "react-router": "^7.6.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "^35.1.4",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "react-router-dom": "^7.5.3",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0"
    }
}
